# Contoh konfigurasi environment — copy file ini ke .env sebelum menjalankan aplikasi

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Pilihan A: Menggunakan PostgreSQL lokal di Docker Compose (default VPS)
# Catatan: ganti password sesuai nilai DB_PASSWORD di bawah
POSTGRES_URL=postgresql://postgres:stoodify_password@db:5432/stoodify?sslmode=disable

# Pilihan B: Menggunakan Supabase / Cloud PostgreSQL eksternal
# POSTGRES_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Variabel untuk service 'db' di docker-compose.yml
DB_USER=postgres
DB_PASSWORD=stoodify_password
DB_NAME=stoodify
DB_PORT=5433

# ------------------------------------------------------------------------------
# 2. Server & Security
# ------------------------------------------------------------------------------
PORT=8080
# Generate via: openssl rand -hex 32
JWT_SECRET=ganti-dengan-hasil-openssl-rand-hex-32

# ------------------------------------------------------------------------------
# 3. AI Bridge (Opsional; jika kosong akan otomatis fallback ke rule-based)
# ------------------------------------------------------------------------------
AI_SCHEDULER_URL=
AI_PREDICTOR_URL=
AI_API_KEY=
AI_FALLBACK_ENABLED=true

# ------------------------------------------------------------------------------
# 4. SMTP (Belum dipakai; untuk fitur verifikasi email)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

