# contoh konfigurasi — copy ke .env lalu isi nilai asli
POSTGRES_URL=postgresql://user:password@host:5432/postgres?sslmode=require
PORT=8080
JWT_SECRET=ganti-dengan-hasil-openssl-rand-hex-32

# AI Bridge (opsional; kosong = fallback rule-based)
AI_SCHEDULER_URL=
AI_PREDICTOR_URL=
AI_API_KEY=
AI_FALLBACK_ENABLED=true

# SMTP (belum dipakai; untuk verifikasi email)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
